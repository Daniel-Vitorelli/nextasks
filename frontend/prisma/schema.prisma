// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?   @db.MediumText // avatar PNG data URL
  timezoneOffset Int? // minutos em relação a UTC (null = fuso do navegador)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  accounts       Account[]
  routines       Routine[]
  tasks          Task[]
  completions    TimeBlockCompletion[]
  connections    TaskBlockConnection[]
  habits         Habit[]
  habitCompletions HabitCompletion[]
  xpEvents       XpEvent[]
  achievements   AchievementUnlock[]
  pushSubscriptions PushSubscription[]
  notificationPreferences NotificationPreference?
  notificationLogs  NotificationLog[]
  friendshipsRequested Friendship[] @relation("FriendshipsRequested")
  friendshipsReceived  Friendship[] @relation("FriendshipsReceived")
  chatConversations    ChatConversation[]
  memoryFacts          MemoryFact[]
  activityEvents       ActivityEvent[]
}

model Routine {
  id          String      @id @default(cuid())
  userId      String
  name        String
  description String?     @db.Text
  frequency   String      @default("daily")
  duration    String      @default("indefinite")
  endDate     DateTime?
  isActive    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeBlocks  TimeBlock[]

  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  priority    Int       @default(3) // 1 (muito baixa) ate 6 (urgente)
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks    Subtask[]
  connections TaskBlockConnection[]

  @@index([userId])
}

model Subtask {
  id          String    @id @default(cuid())
  taskId      String
  parentId    String?
  title       String
  description String?   @db.Text
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent      Subtask?  @relation("SubtaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Subtask[] @relation("SubtaskTree")
  connections TaskBlockConnection[]

  @@index([taskId])
  @@index([parentId])
}

model TimeBlock {
  id           String   @id @default(cuid())
  routineId    String
  title        String
  description  String?  @db.Text
  start        DateTime
  end          DateTime
  isAllDay     Boolean  @default(false)
  color        String   @default("green")
  confirmation String   @default("none") // none | checklist | score
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  routine      Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  completions  TimeBlockCompletion[]
  connections  TaskBlockConnection[]

  @@index([routineId])
}

model TimeBlockCompletion {
  id             String   @id @default(cuid())
  timeBlockId    String
  userId         String
  periodStart    DateTime
  periodEnd      DateTime
  value          String
  // Origem da confirmação: "explicit" (decisão do usuário) ou "auto"
  // (propagada quando uma entidade conectada foi concluída).
  source         String   @default("explicit")
  // Id da entidade (pref. "task:" ou "subtask:") que originou uma
  // confirmação "auto". Null para confirmações explícitas.
  sourceEntityId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  timeBlock  TimeBlock @relation(fields: [timeBlockId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([timeBlockId, periodStart])
  @@index([userId, periodStart])
  @@index([timeBlockId, updatedAt])
  @@index([source, sourceEntityId])
}

/**
 * Conexão M:N entre tarefas/sub-tarefas e blocos de tempo. Concluir um lado
 * propaga para o outro: bloco confirmado (n vezes, filtrado por dia) conclui
 * a entidade conectada; entidade concluída confirma o bloco no período atual.
 * dayFilter: "all" | "weekday:N" (0-6) | "date:YYYY-MM-DD".
 */
model TaskBlockConnection {
  id            String    @id @default(cuid())
  userId        String
  taskId        String?
  subtaskId     String?
  habitId       String?
  timeBlockId   String
  requiredCount Int       @default(1)
  dayFilter     String    @default("all")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  subtask   Subtask?  @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  habit     Habit?    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  timeBlock TimeBlock @relation(fields: [timeBlockId], references: [id], onDelete: Cascade)

  // Como exatamente um de taskId/subtaskId/habitId é preenchido, os índices
  // juntos garantem unicidade por (entidade, bloco) mesmo com NULLs.
  // (CHECK constraint não é suportado pelo Prisma no datasource MySQL;
  // a exclusividade XOR é garantida pela validação da aplicação.)
  @@unique([taskId, timeBlockId])
  @@unique([subtaskId, timeBlockId])
  @@unique([habitId, timeBlockId])
  @@index([userId])
  @@index([timeBlockId])
}

model Habit {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?  @db.Text
  icon        String   // Lucide icon name
  color       String   @default("green") // red | orange | yellow | green | blue | purple | gray
  type        String   @default("good") // good (quer manter) | bad (quer largar)
  frequency   String   @default("daily") // daily | weekly
  daysOfWeek  String   @default("[]") // JSON array of 0-6 (Sunday-Saturday)
  targetCount Int      @default(1) // Number of confirmations needed per period (good habits)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]
  connections TaskBlockConnection[]

  @@index([userId])
}

model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      DateTime // Start of the day in user's timezone
  count     Int      @default(1)
  source    String   @default("explicit") // explicit | auto (via conexões)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

/// Evento append-only do ledger de XP. refKey torna o evento idempotente
/// (ex.: "block:<id>:<periodStartMs>"); eventos sem refKey são únicos por
/// conteúdo. amount pode ser negativo (penalidades).
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String // block.confirm | task.done | habit.confirm | habit.slip ...
  refKey    String?
  amount    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // refKey nulo não participa da unique (MySQL ignora NULL) — eventos sem
  // refKey podem repetir por conteúdo.
  @@unique([userId, kind, refKey])
  @@index([userId, createdAt])
}

/// Subscription de Web Push (uma por navegador/dispositivo). locale é capturado
/// no momento do subscribe para formatar a notificação no servidor.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  locale    String   @default("en") // "pt" | "en"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Preferências de notificação por usuário (criadas on-demand com defaults).
model NotificationPreference {
  userId         String  @id
  friendEvents   Boolean @default(true)
  achievements   Boolean @default(true)
  taskReminders  Boolean @default(true)
  blockReminders Boolean @default(true)
  habitReminders Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Log de envio — garante que cada (kind, refKey) dispare UMA push só,
/// mesmo com o sweep rodando a cada minuto.
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String // friend.request | friend.accept | achievement.unlock | ...
  refKey    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refKey])
  @@index([userId, createdAt])
}

/// Conquista desbloqueada (catálogo vive em código; só o unlock persiste).
model AchievementUnlock {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

/// Amizade/pedido em uma linha só: status "pending" até o destinatário aceitar.
/// Declínio e desfazer amizade removem a linha (permite reconvite).
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("pending") // pending | accepted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendshipsRequested", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

/// Conversa do chatbot (uma linha por thread na página de IA).
model ChatConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String? // derivado da primeira mensagem
  /// Resumo rolante das mensagens antigas (memória de longo prazo da conversa).
  summary   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ChatMessage[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

/// Mensagem individual da conversa.
model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant | system (system nunca persistido aqui)
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Fato durável sobre o usuário ("prefere treinar de manhã"), extraído pela
/// IA ou adicionado manualmente. Entra sempre no system prompt do chatbot.
model MemoryFact {
  id        String   @id @default(cuid())
  userId    String
  fact      String   @db.Text
  source    String   @default("ai") // ai | manual
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

/// Evento de atividade social (alimenta o feed dos amigos). data é um JSON
/// com os parâmetros do kind (ex.: { achievementId } ou { level }).
model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String // autor da ação
  kind      String // achievement.unlock | level.up | friend.accepted
  data      String   @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
